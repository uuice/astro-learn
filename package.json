{
  "name": "",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "node server.mjs",
    "pm2:start": "pm2 start ecosystem.config.cjs --only astro-blog-bun",
    "pm2:stop": "pm2 stop astro-blog-bun",
    "pm2:restart": "pm2 restart astro-blog-bun",
    "pm2:logs": "pm2 logs astro-blog-bun",
    "pm2:delete": "pm2 delete astro-blog-bun",
    "pack": "tar -czvf astro-blog-release-$(date +%Y-%m-%d-%H%M%S).tar.gz dist server.mjs package.json bun.lock ecosystem.config.cjs",
    "pack:build": "bun run build && bun run pack",
    "astro": "astro",
    "lint": "eslint src --ext .js,.astro --fix",
    "lint:check": "eslint src --ext .js,.astro",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.6",
    "@astrojs/node": "^10.1.1",
    "@astrojs/solid-js": "^6.0.1",
    "astro": "^6.3.7",
    "express": "^5.2.1",
    "flexsearch": "^0.8.212",
    "lodash": "^4.18.1",
    "lowdb": "^7.0.1",
    "pinyin": "^4.0.0",
    "pixi.js": "^8.18.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-preset-minify": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-toc": "^9.0.0",
    "solid-js": "^1.9.13",
    "unist-util-visit": "^5.1.0",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.9.1",
    "@typescript-eslint/parser": "^8.59.4",
    "autoprefixer": "^10.5.0",
    "cssnano": "^8.0.1",
    "eslint": "^10.4.0",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-mdx": "^3.7.0",
    "less": "^4.6.4",
    "tailwindcss": "^4.3.0",
    "vitest": "^4.1.7"
  }
}
